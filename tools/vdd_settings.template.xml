<?xml version='1.0' encoding='utf-8'?>
<!-- Relay settings for MikeTheTech's Virtual Display Driver.
     The driver reads this file when its device starts. The host keeps the gpu,
     global and resolutions sections in sync with whatever Mac connects (merging,
     never removing) and restarts the device only when it had to change them;
     everything else here is left alone. The list below covers every Apple laptop
     panel at native, 3/4 and 1/2 size so a restart is normally never needed. -->
<vdd_settings>
    <monitors>
        <count>1</count>
    </monitors>

    <gpu>
        <friendlyname>default</friendlyname>
    </gpu>

    <global>
        <g_refresh_rate>60</g_refresh_rate>
        <g_refresh_rate>120</g_refresh_rate>
    </global>

    <!-- Native, 3/4 and 1/2 sizes of: MacBook Pro 14" and 16" (Apple silicon),
         MacBook Air 13.6" and 15", MacBook Pro/Air 13" (M1/M2), and the Intel-era
         16" and 15" MacBook Pro. -->
    <resolutions>
        <resolution><width>3024</width><height>1964</height><refresh_rate>60</refresh_rate></resolution>
        <resolution><width>2268</width><height>1473</height><refresh_rate>60</refresh_rate></resolution>
        <resolution><width>1512</width><height>982</height><refresh_rate>60</refresh_rate></resolution>
        <resolution><width>3456</width><height>2234</height><refresh_rate>60</refresh_rate></resolution>
        <resolution><width>1728</width><height>1117</height><refresh_rate>60</refresh_rate></resolution>
        <resolution><width>2560</width><height>1664</height><refresh_rate>60</refresh_rate></resolution>
        <resolution><width>1920</width><height>1248</height><refresh_rate>60</refresh_rate></resolution>
        <resolution><width>1280</width><height>832</height><refresh_rate>60</refresh_rate></resolution>
        <resolution><width>2880</width><height>1864</height><refresh_rate>60</refresh_rate></resolution>
        <resolution><width>2160</width><height>1398</height><refresh_rate>60</refresh_rate></resolution>
        <resolution><width>1440</width><height>932</height><refresh_rate>60</refresh_rate></resolution>
        <resolution><width>2560</width><height>1600</height><refresh_rate>60</refresh_rate></resolution>
        <resolution><width>1920</width><height>1200</height><refresh_rate>60</refresh_rate></resolution>
        <resolution><width>1280</width><height>800</height><refresh_rate>60</refresh_rate></resolution>
        <resolution><width>3072</width><height>1920</height><refresh_rate>60</refresh_rate></resolution>
        <resolution><width>2304</width><height>1440</height><refresh_rate>60</refresh_rate></resolution>
        <resolution><width>1536</width><height>960</height><refresh_rate>60</refresh_rate></resolution>
        <resolution><width>2880</width><height>1800</height><refresh_rate>60</refresh_rate></resolution>
        <resolution><width>2160</width><height>1350</height><refresh_rate>60</refresh_rate></resolution>
        <resolution><width>1440</width><height>900</height><refresh_rate>60</refresh_rate></resolution>
    </resolutions>

    <logging>
        <SendLogsThroughPipe>false</SendLogsThroughPipe>
        <logging>false</logging>
        <debuglogging>false</debuglogging>
    </logging>

    <colour>
        <SDR10bit>false</SDR10bit>
        <HDRPlus>false</HDRPlus>
        <ColourFormat>RGB</ColourFormat>
    </colour>

    <cursor>
        <HardwareCursor>true</HardwareCursor>
        <CursorMaxX>128</CursorMaxX>
        <CursorMaxY>128</CursorMaxY>
        <AlphaCursorSupport>true</AlphaCursorSupport>
        <XorCursorSupportLevel>2</XorCursorSupportLevel>
    </cursor>

    <edid>
        <CustomEdid>false</CustomEdid>
        <PreventSpoof>false</PreventSpoof>
        <EdidCeaOverride>false</EdidCeaOverride>
    </edid>
</vdd_settings>
